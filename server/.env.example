# Server Environment Configuration
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:8000

# MongoDB Connection URI
# Leave empty to automatically use the built-in in-memory MongoDB server (zero setup required for local development and testing!)
# Or set your MongoDB Atlas or Local MongoDB connection string:
# MONGODB_URI=mongodb://127.0.0.1:27017/aayush_icd_connect
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication Secret Key
# Replace with a cryptographically strong random string in production (e.g. generated with openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Optional: WHO ICD-11 API Client Credentials (obtain from https://icd.who.int/icdapi)
# Leave blank to rely on pre-indexed offline WHO dataset
ICD_API_CLIENT_ID=your_who_icd_client_id_here
ICD_API_CLIENT_SECRET=your_who_icd_client_secret_here
